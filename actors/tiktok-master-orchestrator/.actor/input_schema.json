    "childTimeoutSecs": {
      "title": "Timeout per child Actor (seconds)",
      "type": "integer",
      "editor": "number",
      "default": 900,
      "minimum": 60,
      "maximum": 3600
    },
    "searchInput": {
      "title": "Creator Search options",
      "type": "object",
      "description": "Optional Creator Search input; filters and linked Profile Actor are enforced by the master."
    }
  }
}
