{
  "title": "TikTok Comments Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "creatorVideos": {
      "title": "Videos grouped by creator",
      "type": "array",
      "editor": "json",
      "description": "Preserves creator attribution. Each item: {creator, videoUrls}.",
      "items": {
        "type": "object",
        "properties": {
          "creator": {
            "type": "string",
            "title": "Creator username",
            "description": "TikTok username without the @ prefix."
          },
          "videoUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Video URL",
              "description": "A direct TikTok video URL."
            },
            "title": "Creator video URLs",
            "description": "TikTok video URLs belonging to this creator."
          }
        },
        "required": [
          "creator",
          "videoUrls"
        ],
        "title": "Creator video group",
        "description": "One creator and the TikTok videos to analyze for that creator."
      }
    },
    "videoUrls": {
      "title": "Video URLs",
      "type": "array",
      "editor": "stringList",
      "items": {
        "type": "string",
        "title": "Video URL",
        "description": "A direct TikTok video URL."
      }
    },
    "postUrls": {
      "title": "Legacy post URLs",
      "type": "array",
      "editor": "json",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Post URL",
            "description": "Direct URL of a TikTok post."
          }
        },
        "required": [
          "url"
        ],
        "title": "Post URL entry",
        "description": "A TikTok post URL entry."
      }
    },
    "maxCommentsPerPost": {
      "title": "Comments per video",
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 1000
    },
    "includeReplies": {
      "title": "Include replies",
      "type": "boolean",
      "default": false
    },
    "minAskers": {
      "title": "Minimum distinct askers",
      "type": "integer",
      "default": 3,
      "minimum": 3
    },
    "minVideos": {
      "title": "Minimum distinct videos",
      "type": "integer",
      "default": 2,
      "minimum": 2
    },
    "languages": {
      "title": "Allowed language codes (optional)",
      "type": "array",
      "editor": "stringList",
      "items": {
        "type": "string",
        "title": "Language code",
        "description": "Language code to include in question detection."
      }
    }
  }
}
