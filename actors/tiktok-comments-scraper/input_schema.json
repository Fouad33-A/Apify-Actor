{
  "title": "TikTok Comments Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "creatorVideos": {
      "title": "Videos grouped by creator",
      "type": "array",
      "editor": "json",
      "description": "Preserves creator attribution. Each item: {creator, videoUrls}.",
      "items": {
        "type": "object",
        "properties": {
          "creator": {
            "type": "string",
            "title": "Creator username"
          },
          "videoUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Video URL"
            },
            "title": "Creator video URLs"
          }
        },
        "required": [
          "creator",
          "videoUrls"
        ],
        "title": "Creator video group"
      }
    },
    "videoUrls": {
      "title": "Video URLs",
      "type": "array",
      "editor": "stringList",
      "items": {
        "type": "string",
        "title": "Video URL"
      }
    },
    "postUrls": {
      "title": "Legacy post URLs",
      "type": "array",
      "editor": "json",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Post URL"
          }
        },
        "required": [
          "url"
        ],
        "title": "Post URL entry"
      }
    },
    "maxCommentsPerPost": {
      "title": "Comments per video",
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 1000
    },
    "includeReplies": {
      "title": "Include replies",
      "type": "boolean",
      "default": false
    },
    "minAskers": {
      "title": "Minimum distinct askers",
      "type": "integer",
      "default": 3,
      "minimum": 3
    },
    "minVideos": {
      "title": "Minimum distinct videos",
      "type": "integer",
      "default": 2,
      "minimum": 2
    },
    "languages": {
      "title": "Allowed language codes (optional)",
      "type": "array",
      "editor": "stringList",
      "items": {
        "type": "string",
        "title": "Language code"
      }
    }
  }
}
